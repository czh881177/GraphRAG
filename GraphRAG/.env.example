# ============================================
# 医药 GraphRAG · 环境变量模板
# 用法：copy .env.example .env  → 编辑 .env 填写真实值
# 注意：.env 已被 .gitignore 忽略，严禁提交到 Git
# ============================================

# ---- Neo4j 图数据库（必填）----
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
# 数据库名（默认 neo4j，Neo4j 5.x 通常无需修改）
# NEO4J_DB=neo4j

# ---- LLM（必填，DeepSeek 或任意 OpenAI 兼容端点）----
# 平台：https://platform.deepseek.com  → API Keys 创建
LLM_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_ENDPOINT=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- Embedding（可选；不配置则自动降级为哈希 Embedder，仅用于离线演示）----
# 建议配置 OpenAI 兼容的 embedding 服务以提升检索效果
# EMBED_ENDPOINT=https://api.deepseek.com/v1
# EMBED_MODEL=text-embedding-ada-002
# EMBED_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxx
