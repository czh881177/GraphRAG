# ============================================
# Medical GraphRAG - Environment Template
# Usage: copy .env.example .env, then edit .env
# NOTE: .env is gitignored - never commit it
# ============================================

# ---- Neo4j Graph Database (required) ----
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
# Database name (default: neo4j; usually no change needed for Neo4j 5.x)
# NEO4J_DB=neo4j

# ---- LLM (required; DeepSeek or any OpenAI-compatible endpoint) ----
# Get your key: https://platform.deepseek.com -> API Keys
LLM_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_ENDPOINT=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- Embedding (recommended for semantic retrieval; falls back to hash if unset) ----
# NOTE: DeepSeek does NOT provide an embedding API. Do not point these at
# api.deepseek.com. Use an OpenAI-compatible embedding provider:
#   - Zhipu GLM (free quota):  https://open.bigmodel.cn -> API Keys
#       EMBED_ENDPOINT=https://open.bigmodel.cn/api/paas/v4
#       EMBED_MODEL=embedding-3        (supports 256-2048 dims)
#   - Aliyun Bailian: https://dashscope.aliyuncs.com/compatible-mode/v1, text-embedding-v2 (1536 dims)
#   - SiliconFlow:   https://api.siliconflow.cn/v1, BAAI/bge-m3 (1024 dims)
# EMBED_DIMENSION must match the Neo4j vector index (default 1536).
# After (re)configuring embeddings, rebuild the graph: build_kg_dyn.ps1
# EMBED_ENDPOINT=https://open.bigmodel.cn/api/paas/v4
# EMBED_MODEL=embedding-3
# EMBED_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# EMBED_DIMENSION=1536
