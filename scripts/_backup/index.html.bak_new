<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>医药GraphRAG问答系统</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:"Microsoft YaHei",sans-serif}
body{background:#f5f7fa;color:#33;height:100vh;display:flex;flex-direction:column}
.header{height:56px;background:linear-gradient(90deg,#1e3a8a,#2563eb);color:#fff;display:flex;align-items:center;padding:0 20px}
.header h1{font-size:18px;font-weight:600}
.header .tag{margin-left:12px;padding:3px 8px;background:rgba(255,255,255,.2);border-radius:10px;font-size:11px}
.main{flex:1;display:flex;overflow:hidden}
.left-panel{width:42%;border-right:1px solid #e2e8f0;background:#fff;display:flex;flex-direction:column}
.input-area{padding:14px 18px;border-bottom:1px solid #e2e8f0}
textarea{width:100%;height:68px;padding:10px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px;outline:none;resize:none}
textarea:focus{border-color:#2563eb}
.input-row{margin-top:8px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.btn{padding:6px 16px;border:none;border-radius:5px;cursor:pointer;font-size:12px}
.btn-primary{background:#2563eb;color:#fff}
.btn-primary:hover{opacity:.9}
.btn-secondary{background:#f1f5f9;color:#475569}
.btn-secondary:hover{background:#e2e8f0}
.btn:disabled{opacity:.5;cursor:not-allowed}
select{padding:5px 8px;border:1px solid #cbd5e1;border-radius:5px;font-size:11px;outline:none;background:#fff}
label{font-size:11px;color:#475569;display:flex;align-items:center;gap:3px;cursor:pointer}
.type-tip{font-size:11px;color:#64748b;margin-top:5px;display:none}
.badge{display:inline-block;padding:2px 7px;border-radius:4px;background:#dbeafe;color:#1e40af;margin-right:5px}
.badge.multi{background:#fef3c7;color:#92400e}
.badge.reverse{background:#ede9fe;color:#6d28d9}
.badge.compare{background:#dcfce7;color:#166534}
.test-panel{padding:10px 18px;background:#f8fafc;border-bottom:1px solid #e2e8f0}
.test-title{font-size:11px;color:#64748b;margin-bottom:6px}
.test-group{margin-bottom:6px}
.test-group-label{font-size:10px;color:#94a3b8;margin-bottom:3px}
.test-btns{display:flex;flex-wrap:wrap;gap:4px}
.test-btn{padding:2px 7px;font-size:10px;background:#fff;border:1px solid #cbd5e1;border-radius:8px;cursor:pointer;color:#334155}
.test-btn:hover{background:#2563eb;color:#fff;border-color:#2563eb}
.answer-area{flex:1;overflow-y:auto;padding:18px}
.section-title{font-size:14px;font-weight:600;margin-bottom:8px;color:#1e293b;display:flex;align-items:center}
.section-title::before{content:"";width:3px;height:12px;background:#2563eb;margin-right:7px;border-radius:2px}
.answer-content{line-height:1.7;font-size:13px;color:#334155;margin-bottom:16px;padding:10px 12px;background:#f8fafc;border-radius:6px;border-left:3px solid #2563eb;white-space:pre-wrap}
.tip-box{background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;padding:7px 10px;border-radius:5px;font-size:11px;margin-bottom:10px;line-height:1.5}
.warn-box{background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:7px 10px;border-radius:5px;font-size:11px;margin-bottom:10px;line-height:1.5}
.entity-list{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:12px}
.entity-tag{padding:3px 8px;background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;border-radius:10px;font-size:11px}
.evidence-card{padding:8px 10px;border:1px solid #e2e8f0;border-radius:6px;margin-bottom:6px;font-size:12px;line-height:1.5;color:#64748b;background:#fafafa}
.evidence-card .source{font-size:10px;color:#94a3b8;margin-top:3px}
.compare-table{width:100%;border-collapse:collapse;margin-bottom:16px;font-size:12px}
.compare-table th,.compare-table td{border:1px solid #e2e8f0;padding:8px 10px;vertical-align:top;line-height:1.5}
.compare-table th{background:#f1f5f9;font-weight:600;text-align:left;color:#1e293b}
.compare-table td:first-child{width:50%;background:#f8fafc}
.compare-table .missing{color:#94a3b8;font-style:italic}
.right-panel{flex:1;display:flex;flex-direction:column;background:#fff}
.graph-header{padding:12px 18px;border-bottom:1px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center}
.graph-header .tip{font-size:11px;color:#94a3b8}
.graph-frame{flex:1;border:none;width:100%;height:100%}
.loading{text-align:center;padding:35px 15px;color:#94a3b8;font-size:13px;line-height:1.7}
.error{color:#dc2626;padding:10px;background:#fef2f2;border-radius:5px;font-size:12px;line-height:1.5}
.meta-info{font-size:11px;color:#64748b;margin-top:6px;padding:6px 8px;background:#f1f5f9;border-radius:4px}
ul.answer-list{padding-left:20px;margin:0}
ul.answer-list li{margin-bottom:4px;line-height:1.6}
</style>
</head>
<body>
<div class="header">
    <h1>医药知识图谱增强问答系统</h1>
    <span class="tag">GraphRAG + Neo4j + DeepSeek</span>
</div>
<div class="main">
    <div class="left-panel">
        <div class="input-area">
            <textarea id="q" placeholder="请输入问题，例如：拜耳研发的药物有哪些副作用？"></textarea>
            <div class="input-row">
                <select id="method">
                    <option value="vector_cypher">向量+图谱</option>
                    <option value="vector">纯向量</option>
                    <option value="hybrid">混合检索</option>
                    <option value="hybrid_cypher" selected>混合图谱(推荐)</option>
                </select>
                <label><input type="checkbox" id="autoOpt" checked>智能优化</label>
                <label><input type="checkbox" id="autoSplit" checked>对比拆分</label>
                <button class="btn btn-primary" id="askBtn">提问</button>
                <button class="btn btn-secondary" id="clearBtn">清空</button>
            </div>
            <div class="type-tip" id="typeTip"></div>
        </div>
        <div class="test-panel">
            <div class="test-title">📋 标准测试集</div>
            <div class="test-group">
                <div class="test-group-label">单跳</div>
                <div class="test-btns">
                    <button class="test-btn" data-q="阿司匹林的作用机制是什么？">Q1机制</button>
                    <button class="test-btn" data-q="哪些药物通过抑制环氧合酶发挥作用？">Q2药物</button>
                    <button class="test-btn" data-q="布洛芬有哪些副作用？">Q3副作用</button>
                    <button class="test-btn" data-q="拜耳研发了哪些药物？">Q4药物</button>
                </div>
            </div>
            <div class="test-group">
                <div class="test-group-label">多跳</div>
                <div class="test-btns">
                    <button class="test-btn" data-q="服用阿司匹林会引发什么症状？">Q5症状</button>
                    <button class="test-btn" data-q="拜耳研发的药物有哪些副作用？">Q6副作用</button>
                </div>
            </div>
            <div class="test-group">
                <div class="test-group-label">反向&跨实体</div>
                <div class="test-btns">
                    <button class="test-btn" data-q="环氧合酶与哪些药物有关？">Q7反向</button>
                    <button class="test-btn" data-q="哪些药物可以治疗头痛？">Q9治疗</button>
                    <button class="test-btn" data-q="长期服用布洛芬有什么风险？">Q10风险</button>
                </div>
            </div>
            <div class="test-group">
                <div class="test-group-label">比较</div>
                <div class="test-btns">
                    <button class="test-btn" data-q="对乙酰氨基酚的作用机制与布洛芬有什么不同？">Q8对比</button>
                </div>
            </div>
        </div>
        <div class="answer-area" id="answer">
            <div class="loading">输入问题后点击「提问」<br>系统将基于知识图谱生成答案并标注证据</div>
        </div>
    </div>
    <div class="right-panel">
        <div class="graph-header">
            <div class="section-title" style="margin:0">知识图谱</div>
            <span class="tip">滚轮缩放 · 拖拽移动 · 点击查看</span>
        </div>
        <iframe class="graph-frame" id="graph" src="graphragexpr/vis/output/graph.html"></iframe>
    </div>
</div>

<script>
// ===================== 常量配置 =====================
const CONFIG = {
    API: 'http://localhost:5000/api/graphrag',
    RETRY_MODES: ['vector_cypher', 'hybrid_cypher', 'hybrid'],
    SYMPTOMS: ["头痛","水肿","耳鸣","消化不良","便秘","过敏反应","高血压","高血脂","糖尿病","心绞痛","心肌梗死","脑梗死"],
    TYPE_BADGE: {
        single: '',
        multi: 'multi',
        reverse: 'reverse',
        cross: '',
        compare: 'compare'
    },
    TYPE_LABEL: {
        single: '单跳事实查询',
        multi: '多跳推理问题',
        reverse: '反向关系查询',
        cross: '跨实体查询',
        compare: '比较类问题'
    }
};

// 实体库
const ENTITIES = [
    "硝苯地平","氨氯地平","瑞舒伐他汀","阿托伐他汀","布洛芬","对乙酰氨基酚","阿司匹林","吲哚美辛",
    "高血压","高血脂","糖尿病","心绞痛","心肌梗死","脑梗死","头痛","水肿","耳鸣","消化不良","便秘","过敏反应",
    "拜耳","葛兰素史克","默沙东","辉瑞","诺华",
    "环氧合酶","COX","HMG-CoA还原酶","钙离子通道",
    "二甲双胍","格列本脲","胰岛素","西地那非","氯沙坦","依那普利","奥美拉唑","法莫替丁"
];

// 实体别名映射
const ENTITY_ALIAS = {
    "拜耳公司":"拜耳","拜耳医药":"拜耳","拜耳集团":"拜耳",
    "葛兰素史克公司":"葛兰素史克","葛兰素史克制药":"葛兰素史克","GSK":"葛兰素史克",
    "默沙东公司":"默沙东","默克":"默沙东","MSD":"默沙东",
    "阿司匹林肠溶片":"阿司匹林","拜阿司匹灵":"阿司匹林","乙酰水杨酸":"阿司匹林",
    "布洛芬缓释胶囊":"布洛芬","芬必得":"布洛芬","布洛芬片":"布洛芬",
    "扑热息痛":"对乙酰氨基酚","泰诺":"对乙酰氨基酚",
    "环氧化酶":"环氧合酶","COX酶":"环氧合酶","cox":"环氧合酶","COX":"环氧合酶",
    "高血压病":"高血压","血压高":"高血压","高脂血症":"高血脂","头疼":"头痛","浮肿":"水肿"
};

// ===================== DOM缓存 =====================
const $ = {
    q: document.getElementById('q'),
    method: document.getElementById('method'),
    autoOpt: document.getElementById('autoOpt'),
    autoSplit: document.getElementById('autoSplit'),
    askBtn: document.getElementById('askBtn'),
    clearBtn: document.getElementById('clearBtn'),
    typeTip: document.getElementById('typeTip'),
    answer: document.getElementById('answer'),
    graph: document.getElementById('graph')
};

// ===================== 工具函数 =====================
// 实体归一化
function normalizeEntity(text) {
    let result = text;
    for (const [alias, standard] of Object.entries(ENTITY_ALIAS)) {
        result = result.replaceAll(alias, standard);
    }
    return result;
}

// 提取匹配实体
function matchEntities(text) {
    return ENTITIES.filter(e => text.includes(e));
}

// 问题分类
function classifyQuestion(q) {
    if (/(.+?)的(.+?)[和与](.+?)(?:的.*?)?(有什么|有哪些)?(不同|区别|差异|异同)/.test(q)
        || /(.+?)[和与](.+?)的(区别|不同|差异|异同)/.test(q)) {
        return 'compare';
    }
    if (/(.+与哪些.+有关|.+和哪些.+相关|哪些.+会.+|哪些.+可以.+)/.test(q)) {
        return 'reverse';
    }
    if (/(.+研发的药物有哪些|.+的药物有哪些副作用|.+会引发什么症状|长期服用.+有什么风险)/.test(q)) {
        return 'multi';
    }
    if (/(哪些药物可以治疗|哪些药物会引起|治疗.+的药物有哪些)/.test(q)) {
        return 'cross';
    }
    return 'single';
}

// 自动匹配最优模式
function autoSelectMethod(type) {
    // 单跳：纯混合检索，完全避开图谱锚定的类型bug，最稳定
    if (type === 'single') return 'hybrid';
    // 反向/跨实体：优先向量图谱，遇500自动降级到混合
    if (['reverse', 'cross'].includes(type)) return 'vector_cypher';
    // 多跳/对比：混合图谱，遇500自动降级
    if (['multi', 'compare'].includes(type)) return 'hybrid_cypher';
    return 'hybrid';
}


// 生成优化Prompt
function buildPrompt(q, type) {
    const entities = matchEntities(q);
    const core = entities[0];

    const prompts = {
        single: core
            ? `请仅围绕「${core}」回答：${q}。详细说明靶点、机制、症状，分点呈现，不涉及无关药物`
            : `${q}，请详细说明，分点清晰呈现`,
        multi: core
            ? `${q}。以「${core}」为起点，完整遍历图谱关系链，分点列出全部结果，不要遗漏`
            : `${q}，遍历所有关系链，完整列出结果`,
        reverse: core
            ? `${q}。从「${core}」节点出发，反向遍历所有关联药物实体，完整列出`
            : `${q}，反向遍历所有关联实体，完整列出结果`,
        cross: `${q}，遍历完整关系路径，找出所有符合条件的实体，分点列出`
    };
    return prompts[type] || q;
}

// 解析对比问题
function parseCompare(q) {
    let m = q.match(/(.+?)的(.+?)[和与](.+?)(?:的.*?)?(有什么|有哪些)?(不同|区别|差异|异同)/);
    if (m) return { e1: m[1].trim(), e2: m[3].trim(), attr: m[2].trim() };
    m = q.match(/(.+?)[和与](.+?)的(区别|不同|差异|异同)/);
    if (m) return { e1: m[1].trim(), e2: m[2].trim(), attr: '相关信息' };
    return null;
}

// 调用接口
async function fetchAPI(question, method) {
    try {
        const res = await fetch(CONFIG.API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question, method })
        });
        if (!res.ok) {
            const err = new Error('状态码：' + res.status);
            err.status = res.status;
            throw err;
        }
        return res.json();
    } catch (e) {
        // 网络错误也标记为500级，走重试逻辑
        if (!e.status) e.status = 500;
        throw e;
    }
}


// 提取纯文本答案
function extractAnswer(data) {
    if (!data?.answer) return '';
    return data.answer
        .replace(/根据提供的上下文[，,]?/g, '')
        .replace(/上下文仅包含[^\n]*\n?/g, '')
        .replace(/具体如下[:：]\n?/g, '')
        .trim();
}

// 提取图谱节点
function extractNodes(data) {
    if (data?.graph_nodes?.length) return data.graph_nodes;
    if (data?.nodes?.length) return data.nodes.map(n => n.name || n.id || n);
    return [];
}

// 判断是否空答案
function isEmptyAnswer(text) {
    if (!text?.trim()) return true;
    const emptyKeys = ['无法回答','信息不足','未找到','没有找到','无法完整回答','未包含','未提及','暂无答案'];
    return emptyKeys.some(k => text.includes(k));
}

// 答案结构化
function formatAnswer(text) {
    if (!text?.trim()) return '';
    if (/^\d\./m.test(text)) return text;
    const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
    if (lines.length <= 2) return text;
    return '<ul class="answer-list">'
        + lines.map(l => `<li>${l.replace(/^[-*•]\s*/, '')}</li>`).join('')
        + '</ul>';
}

// 数组去重
function unique(arr) {
    return [...new Set(arr)];
}

// ===================== 渲染函数 =====================
// 显示类型提示
function showTypeTip(type) {
    const cls = CONFIG.TYPE_BADGE[type];
    const label = CONFIG.TYPE_LABEL[type];
    $.typeTip.innerHTML = `<span class="badge ${cls}">${label}</span>已匹配最优检索策略`;
    $.typeTip.style.display = 'block';
}

// 渲染实体标签
function renderEntityTags(nodes) {
    if (!nodes?.length) return '';
    return '<div class="entity-list">'
        + nodes.map(n => `<span class="entity-tag">${n}</span>`).join('')
        + '</div>';
}

// 渲染证据列表
function renderEvidence(evidence) {
    if (!evidence?.length) return '';
    let html = '<div class="section-title">支撑证据</div>';
    evidence.forEach((item, i) => {
        const text = typeof item === 'string' ? item : (item.text || item.content || '');
        html += `<div class="evidence-card"><div>${text}</div><div class="source">证据 ${i+1}</div></div>`;
    });
    return html;
}

// 渲染对比结果
function renderCompareResult(c, r1, r2, retryIndex) {
    const t1 = extractAnswer(r1);
    const t2 = extractAnswer(r2);
    const n1 = extractNodes(r1 || {});
    const n2 = extractNodes(r2 || {});
    const e1 = matchEntities(t1);
    const e2 = matchEntities(t2);
    const allNodes = unique([...n1, ...n2, ...e1, ...e2]);

    let html = '<div class="section-title">回答</div>';
    if (retryIndex > 0) html += `<div class="meta-info">💡 已自动切换检索模式重试（第${retryIndex}次）</div>`;
    html += `<div style="font-size:12px;color:#64748b;margin-bottom:6px">对比维度：${c.attr}</div>`;
    html += `
        <table class="compare-table">
            <thead><tr><th>${c.e1}</th><th>${c.e2}</th></tr></thead>
            <tbody><tr>
                <td>${t1 ? formatAnswer(t1) : '<span class="missing">暂未检索到</span>'}</td>
                <td>${t2 ? formatAnswer(t2) : '<span class="missing">暂未检索到</span>'}</td>
            </tr></tbody>
        </table>
    `;

    const ev = [];
    if (r1?.evidence) ev.push(...r1.evidence);
    if (r2?.evidence) ev.push(...r2.evidence);
    html += renderEvidence(ev);

    if (allNodes.length) {
        html += `<div class="meta-info">📊 关联 <b>${allNodes.length}</b> 个图谱实体，右侧已高亮</div>`;
        triggerHighlight(allNodes);
    }
    return html;
}

// 治疗类问题兜底
async function renderTreatmentFallback(symptom, method, allNodes) {
    if (!CONFIG.SYMPTOMS.includes(symptom)) {
        return '';
    }

    let html = `<div class="tip-box">💡 当前图谱中「${symptom}」主要作为副作用实体建模，暂无明确的“治疗”关系。以下为会引起${symptom}的药物参考：</div>`;

    try {
        const reverseQ = `找出所有副作用包含${symptom}的药物，沿「药物-副作用」关系遍历，完整列出所有药物名称`;
        const reverseData = await fetchAPI(reverseQ, 'vector_cypher');
        const reverseText = extractAnswer(reverseData);

        if (!isEmptyAnswer(reverseText)) {
            html += `<div class="answer-content">${formatAnswer(reverseText)}</div>`;
            const reverseNodes = extractNodes(reverseData);
            const reverseTextNodes = matchEntities(reverseText);
            allNodes.push(...unique([...reverseNodes, ...reverseTextNodes]));
        } else {
            html += `<div class="warn-box">⚠️ 暂未查询到与${symptom}相关的药物信息</div>`;
        }
    } catch (e) {
        html += `<div class="warn-box">⚠️ 查询关联信息失败，请稍后重试</div>`;
    }
    return html;
}

// ===================== 图谱交互 =====================
function triggerHighlight(nodes) {
    if (!$.graph?.contentWindow) return;
    setTimeout(() => {
        $.graph.contentWindow.postMessage({ type: 'highlight', nodes }, '*');
    }, 300);
}

function resetHighlight() {
    if (!$.graph?.contentWindow) return;
    $.graph.contentWindow.postMessage({ type: 'reset' }, '*');
}

// ===================== 主业务逻辑 =====================
async function handleAsk(retryIndex = 0) {
    const origin = $.q.value.trim();
    if (!origin) return;

    $.askBtn.disabled = true;
    $.askBtn.textContent = retryIndex > 0 ? '重试中...' : '生成中...';
    if (retryIndex === 0) {
        $.answer.innerHTML = '<div class="loading">正在检索知识图谱<br>并生成答案，请稍候...</div>';
    }
    $.typeTip.style.display = 'none';
    resetHighlight();

    try {
        const nq = normalizeEntity(origin);
        const type = classifyQuestion(nq);
        const autoOpt = $.autoOpt.checked;
        const autoSplit = $.autoSplit.checked;

        // 选择模式
        let method = retryIndex > 0 
            ? CONFIG.RETRY_MODES[retryIndex] 
            : $.method.value;
        if (autoOpt && retryIndex === 0) {
            method = autoSelectMethod(type);
        }

        showTypeTip(type);

        // ===== 对比类问题 =====
        if (autoSplit && type === 'compare') {
            const c = parseCompare(nq);
            if (c) {
                const q1 = buildPrompt(`${c.e1}的${c.attr}是什么`, 'single');
                const q2 = buildPrompt(`${c.e2}的${c.attr}是什么`, 'single');
                const [r1, r2] = await Promise.all([
                    fetchAPI(q1, method).catch(() => null),
                    fetchAPI(q2, method).catch(() => null)
                ]);
                $.answer.innerHTML = renderCompareResult(c, r1, r2, retryIndex);
                $.answer.scrollTop = 0;
                $.askBtn.disabled = false;
                $.askBtn.textContent = '提问';
                return;
            }
        }

        // ===== 普通问题 =====
        const finalQ = autoOpt ? buildPrompt(nq, type) : nq;
        const data = await fetchAPI(finalQ, method);
        const answerText = extractAnswer(data);
        const empty = isEmptyAnswer(answerText);

        // 空答案自动重试
        if (empty && retryIndex < CONFIG.RETRY_MODES.length - 1) {
            return handleAsk(retryIndex + 1);
        }

        const graphNodes = extractNodes(data);
        const textNodes = matchEntities(answerText);
        const allNodes = unique([...graphNodes, ...textNodes]);

        let html = '<div class="section-title">回答</div>';
        if (retryIndex > 0) {
            html += `<div class="meta-info">💡 已自动切换检索模式重试（第${retryIndex}次）</div>`;
        }

        // 治疗类问题兜底
        const isTreat = /哪些药物可以治疗|治疗.+的药物有哪些/.test(nq);
        if (isTreat && empty) {
            const symptom = matchEntities(nq)[0] || '该症状';
            html += await renderTreatmentFallback(symptom, method, allNodes);
        } else {
            html += `<div class="answer-content">${formatAnswer(answerText)}</div>`;
        }

        html += renderEntityTags(allNodes);
        html += renderEvidence(data.evidence);

        if (allNodes.length) {
            html += `<div class="meta-info">📊 关联 <b>${allNodes.length}</b> 个图谱实体，右侧已高亮</div>`;
            triggerHighlight(allNodes);
        }

        $.answer.innerHTML = html;

    } catch (err) {
        // 500错误自动降级重试
        if (err.status === 500 && retryIndex < CONFIG.RETRY_MODES.length - 1) {
            return handleAsk(retryIndex + 1);
        }
        $.answer.innerHTML = `<div class="error"><b>调用失败：</b>${err.message}<br>请确认后端服务已启动</div>`;
    } finally {
        $.askBtn.disabled = false;
        $.askBtn.textContent = '提问';
        $.answer.scrollTop = 0;
    }
}

// 清空
function handleClear() {
    $.q.value = '';
    $.typeTip.style.display = 'none';
    $.answer.innerHTML = '<div class="loading">输入问题后点击「提问」<br>系统将基于知识图谱生成答案并标注证据</div>';
    resetHighlight();
}

// ===================== 事件绑定 =====================
$.askBtn.addEventListener('click', () => handleAsk());
$.clearBtn.addEventListener('click', handleClear);
$.q.addEventListener('keydown', e => {
    if (e.ctrlKey && e.key === 'Enter') handleAsk();
});

// 测试集按钮事件委托
document.querySelector('.test-panel').addEventListener('click', e => {
    const btn = e.target.closest('.test-btn');
    if (btn) {
        $.q.value = btn.dataset.q;
        handleAsk();
    }
});
</script>
</body>
</html>
